{
  "name": "@growth-manager/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@growth-manager/domain": "workspace:*",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
