{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "apps/worker/api/pump.ts": {
      "maxDuration": 800,
      "memory": 2048
    },
    "apps/worker/api/reconcile.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "apps/worker/api/health.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/pump",
      "destination": "/apps/worker/api/pump"
    },
    {
      "source": "/api/reconcile",
      "destination": "/apps/worker/api/reconcile"
    },
    {
      "source": "/api/health",
      "destination": "/apps/worker/api/health"
    }
  ],
  "crons": [
    {
      "path": "/api/reconcile",
      "schedule": "*/5 * * * *"
    }
  ]
}
