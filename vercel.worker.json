{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "builds": [
    {
      "src": "api/pump.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/reconcile.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/worker-health.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/pump",
      "destination": "/api/pump"
    },
    {
      "source": "/api/reconcile",
      "destination": "/api/reconcile"
    },
    {
      "source": "/api/health",
      "destination": "/api/worker-health"
    }
  ],
  "crons": [
    {
      "path": "/api/reconcile",
      "schedule": "*/5 * * * *"
    }
  ]
}
