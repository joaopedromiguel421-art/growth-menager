{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "builds": [
    {
      "src": "api/pump.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/reconcile.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/worker-health.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "source": "/api/pump",
      "dest": "/api/pump.ts"
    },
    {
      "source": "/api/reconcile",
      "dest": "/api/reconcile.ts"
    },
    {
      "source": "/api/health",
      "dest": "/api/worker-health.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/reconcile",
      "schedule": "*/5 * * * *"
    }
  ]
}
