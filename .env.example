APP_ENV=development
APP_VERSION=0.1.0
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
REPORTS_BASE_URL=http://localhost:3000/portal
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=local-publishable-key
SUPABASE_SECRET_KEY=local-secret-key
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# Local Supabase only. In production this MUST point at the Supavisor pooler:
# the direct host db.<ref>.supabase.co resolves to IPv6 only and Vercel functions
# have no IPv6 egress, so a direct URL fails every query with a connection error.
#   postgresql://gm_api.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Port 6543 is transaction mode, which matches the `prepare: false` client setting.
# Never deploy with the `postgres` superuser: it has BYPASSRLS and would silently
# disable every tenant isolation policy.
DATABASE_URL=postgresql://gm_api:local-only@127.0.0.1:54322/postgres
DATABASE_MIGRATOR_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
RESEND_API_KEY=re_test_only
RESEND_WEBHOOK_SECRET=whsec_test_only
# Sender for team invitations; the domain must be verified in Resend.
RESEND_FROM_EMAIL=convites@growthmanager.com.br
INTERNAL_WORKER_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured
META_CLIENT_ID=not-configured
META_CLIENT_SECRET=not-configured
DATAFORSEO_LOGIN=not-configured
DATAFORSEO_PASSWORD=not-configured
DEEPSEEK_API_KEY=not-configured
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
FIRECRAWL_API_KEY=not-configured
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
FEATURE_PASSKEYS=false
FEATURE_REAL_PROVIDERS=false
FEATURE_SEO_MONITORING=false
FEATURE_SEO_REAL_PROVIDERS=false
FEATURE_SEO_DEEPSEEK=false
FEATURE_SEO_AUTO_TASKS=false
