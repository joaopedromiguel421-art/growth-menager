{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "outputDirectory": "public",
  "buildCommand": "pnpm turbo run build --filter=@growth-manager/worker",
  "functions": {
    "api/pump.ts": {
      "maxDuration": 300,
      "memory": 2048
    },
    "api/reconcile.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/health.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "crons": [
    {
      "path": "/api/pump",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/reconcile",
      "schedule": "0 8 * * *"
    }
  ]
}
