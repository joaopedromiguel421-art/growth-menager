{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/pump.ts": {
      "maxDuration": 800,
      "memory": 2048
    },
    "api/reconcile.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/health.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "crons": [
    {
      "path": "/api/reconcile",
      "schedule": "*/5 * * * *"
    }
  ]
}
